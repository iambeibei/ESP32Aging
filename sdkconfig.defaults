CONFIG_BRIDGE_DATA_FORWARDING_NETIF_SOFTAP=y
CONFIG_MESH_LITE_ENABLE=y
CONFIG_MESH_LITE_MAXIMUM_LEVEL_ALLOWED=6
CONFIG_BRIDGE_SOFTAP_MAX_CONNECT_NUMBER=5

# --- 有线以太网（KSZ8851SNL over SPI）作为根节点上行 ---
# 以太网与 WiFi STA 同时作为 external netif（二者可并存）。
# 注意：WIFI_STA_DEF 的 route_prio=100 高于 ETH_WAN 的 50，自动选择反而偏向 STA；
# 「以太网优先」由 dual_net 显式 esp_netif_set_default_netif() 覆盖实现，
# 因此 dual_net.h 的 DUAL_NET_ENABLE_ROUTE_CONTROL 必须保持为 1。
# 另注：CONFIG_BRIDGE_EXTERNAL_NETIF_ETHERNET 与 CONFIG_BRIDGE_DATA_FORWARDING_NETIF_ETHERNET
# 互斥，此处取前者（以太网作 WAN 出口，SoftAP 仍是数据转发口）。
CONFIG_BRIDGE_EXTERNAL_NETIF_ETHERNET=y

# SPI 引脚沿用原硬件接线（iot_bridge 的 S3 默认值为 SCLK 12 / MOSI 11 / MISO 13 / CS0 10）
CONFIG_BRIDGE_ETH_SPI_HOST=1
CONFIG_BRIDGE_ETH_SPI_SCLK_GPIO=6
CONFIG_BRIDGE_ETH_SPI_MOSI_GPIO=15
CONFIG_BRIDGE_ETH_SPI_MISO_GPIO=7
CONFIG_BRIDGE_ETH_SPI_CS0_GPIO=16
CONFIG_BRIDGE_ETH_SPI_INT0_GPIO=4

# Note: do NOT raise CONFIG_LOG_MAXIMUM_LEVEL here. The closed-source esp-mesh-lite
# library logs through its own esp_mesh_lite_log_write(), guarded by the fixed
# ESP_MESH_LITE_LOG_LEVEL=ESP_LOG_DEBUG in esp_mesh_lite_log.h, so its DEBUG lines are
# already compiled in and only need esp_log_level_set() at runtime. Raising the global
# maximum would also recompile every open-source component with DEBUG/VERBOSE, which
# does not fit the remaining space in the OTA partitions.

# 不生成 core dump；保留普通串口 panic/backtrace，随后按原延时重启。
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# Keep the panic output on the serial console long enough to be captured in full.
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=5

# --- Mesh-Lite 原生 OTA 分发（LAN OTA，MESH_LITE_OTA_INTEGRATION.md）---
# 子节点收到 OTA 命令后经 mesh 内逐级向父/根请求固件，根节点外网只下载 1 份；
# extern_url_ota_cb 传禁用桩（mesh 内拿不到即失败），无外网兜底。
CONFIG_ESP_MESH_LITE_OTA_ENABLE=y
# 下载完成后不自动重启：保持本项目 CanRestart 统一点火流程（AGENTS.md）。
CONFIG_OTA_AUTO_RESTART=n
CONFIG_OTA_AUTO_CANCEL_ROLLBACK=y
# 每包传输长度（组件上限 1376）与接收窗口（6 包），用组件默认值。
CONFIG_OTA_DATA_LEN=1376
CONFIG_OTA_WND_DEFAULT=8256

# 运行时间统计仅为已移除的 CPU 占用率诊断服务，保持 Kconfig 默认关闭；
# 重新开启会恢复每任务计数与上下文切换开销，且当前无消费者。

# --- 以下为 2026-10-19 从 build/mesh-lite/sdkconfig 手工设置补入 defaults ---
# 背景：删除 sdkconfig 重新生成时这些项全部回落到 Kconfig 默认值
# （Flash 2MB / 单 app 分区表 / BT 关闭 / PSRAM 关闭），导致编译失败。
# 之后重新生成 sdkconfig 不再丢配置；生效范围仅限"生成新配置"。

# Flash 与分区表（自定义 partition.csv，8MB）
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition.csv"
CONFIG_PARTITION_TABLE_FILENAME="partition.csv"

# 无证书 HTTPS 放行（OTA/GetMissingIdNums 等内网 IP 访问依赖，见 OTA_SERVER_MIGRATION_DESIGN.md 第 8 节）
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# PSRAM（ESP32-S3 8MB 型号必备；app_malloc_prefer_psram 依赖）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_SPEED=40
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_DEFAULT_PSRAM_CLK_IO=30
CONFIG_DEFAULT_PSRAM_CS_IO=26
CONFIG_STDATOMIC_S32C1I_SPIRAM_WORKAROUND=y
CONFIG_ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND=y
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# BLE（老化设备通信走 Bluedroid；其余细项保持 Kconfig 默认）
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_SMP_ENABLE=y
CONFIG_BT_ACL_CONNECTIONS=4

# BLE + HTTPS 协议拉取并发：可外置的 Bluedroid 堆与 mbedTLS 动态数据使用 PSRAM。
# 保留控制器/DMA/任务栈内部内存，不缩减 TLS 报文长度或关闭 HTTPS。
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Wi-Fi/BT 共存
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_SW_COEXIST_ENABLE=y

# 以太网硬件（KSZ8851SNL，根节点有线上行，见 DUAL_NET_DESIGN.md）
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=y

# lwIP 调优（mesh 多跳转发场景，实测沿用值）
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_MSS=1360
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5440
CONFIG_LWIP_TCP_WND_DEFAULT=5440
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=64

# SoftAP SSID 带 MAC 后缀（mesh.c 两种模式之一，须与实际配置一致）
CONFIG_BRIDGE_SOFTAP_SSID_END_WITH_THE_MAC=y

# MQTT：有界 outbox，负载优先使用 PSRAM；删除通知驱动上线/订阅恢复。
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_OUTBOX_DATA_ON_EXTERNAL_MEMORY=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=120000
CONFIG_MQTT_REPORT_DELETED_MESSAGES=y
