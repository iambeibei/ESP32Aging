CONFIG_BRIDGE_DATA_FORWARDING_NETIF_SOFTAP=y
CONFIG_MESH_LITE_ENABLE=y
CONFIG_MESH_LITE_MAXIMUM_LEVEL_ALLOWED=6
CONFIG_BRIDGE_SOFTAP_MAX_CONNECT_NUMBER=5

# Note: do NOT raise CONFIG_LOG_MAXIMUM_LEVEL here. The closed-source esp-mesh-lite
# library logs through its own esp_mesh_lite_log_write(), guarded by the fixed
# ESP_MESH_LITE_LOG_LEVEL=ESP_LOG_DEBUG in esp_mesh_lite_log.h, so its DEBUG lines are
# already compiled in and only need esp_log_level_set() at runtime. Raising the global
# maximum would also recompile every open-source component with DEBUG/VERBOSE, which
# does not fit the remaining space in the OTA partitions.

# --- Diagnostics for the LoadProhibited crash during mesh scan retry ---
CONFIG_ESP_COREDUMP_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_LOGS=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# Keep the panic output on the serial console long enough to be captured in full.
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=5
